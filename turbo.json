{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NOTION_TOKEN",
        "NOTION_PAGE_ID",
        "NEXT_PUBLIC_GA_ID",
        "UNSPLASH_ACCESS_KEY",
        "WALLPAPER_KEYWORDS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NOTION_TOKEN",
    "NOTION_PAGE_ID",
    "NEXT_PUBLIC_GA_ID",
    "UNSPLASH_ACCESS_KEY",
    "WALLPAPER_KEYWORDS"
  ]
}
